# Copy to backend/.env and fill in the keys. Every other setting has a default in app/core/config.py.

APP_ENV=development
DEBUG=true
# Random 32+ character string used to sign JWTs
SECRET_KEY=change-me-to-a-random-64-char-string

# PostgreSQL 16 + pgvector (Docker Compose overrides these with the `postgres` service)
DATABASE_URL=postgresql+asyncpg://airw:airw_dev_password@localhost:5432/airw_dev
DATABASE_URL_SYNC=postgresql://airw:airw_dev_password@localhost:5432/airw_dev

# Neo4j knowledge graph (Docker Compose overrides these with the `neo4j` service)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=airw_dev_password

# Google AI Studio key: chat model and embeddings. Ingestion fails without it.
GEMINI_API_KEY=
# Tavily key for web search. Leave empty to disable the web.
TAVILY_API_KEY=
# Optional: raises the GitHub API limit for repository ingestion
GITHUB_TOKEN=
# Optional: OAuth Web Client ID for "Sign in with Google" (the button is hidden when empty)
GOOGLE_CLIENT_ID=

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Load the reranker model (cross-encoder/ms-marco-MiniLM-L-6-v2) from the local Hugging Face cache only.
# Leave false for the first run so the model can download; with an empty cache, true skips reranking.
HF_HUB_OFFLINE=false
